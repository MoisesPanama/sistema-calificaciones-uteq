<%- include('../partials/header') %>

<h1>Registrar Calificaciones</h1>

<p class="periodo-fijo">
  Periodo activo (fijo): <strong><%= periodoActivo ? periodoActivo.nombre : '—' %></strong>.
  Todo lo que registre queda en este periodo.
  <% if (String(idPeriodoSeleccionado) !== String(periodoActivo ? periodoActivo.id_periodo : '')) { %>
    Viendo histórico: <strong><%= periodoNombre %></strong>
    (<a href="/calificaciones/nueva">volver al activo</a>).
  <% } %>
</p>

<% if (typeof exito !== 'undefined' && exito) { %>
  <div class="alert alert-exito">
    <%= exito === '1' || exito === 1 ? 'Calificación registrada correctamente.' : exito %>
  </div>
<% } %>

<% if (errores && errores.length > 0) { %>
  <div class="alert alert-error">
    <ul>
      <% errores.forEach(function(err) { %>
        <li><%= err %></li>
      <% }); %>
    </ul>
  </div>
<% } %>

<% if (materias.length === 0) { %>
  <div class="alert alert-error">
    No tiene materias asignadas en este periodo. Pida al administrador que le asigne
    materias en <strong>profesor_materia_periodo</strong> (materia + curso + periodo).
  </div>
<% } %>

<div class="form-box">
  <form action="/calificaciones/nueva" method="GET">
    <input type="hidden" name="id_periodo" value="<%= idPeriodoSeleccionado %>">

    <label for="id_materia_filtro">Materia (solo las que usted dicta)</label>
    <select id="id_materia_filtro" name="id_materia" onchange="this.form.submit()" required>
      <option value="">-- Selecciona una materia --</option>
      <% materias.forEach(function(materia) { %>
        <option
          value="<%= materia.id_materia %>"
          <%= String(idMateriaSeleccionada) === String(materia.id_materia) ? 'selected' : '' %>
        >
          <%= materia.nombre %>
        </option>
      <% }); %>
    </select>

    <% if (cursos && cursos.length > 0) { %>
      <label for="id_curso_filtro">Curso</label>
      <select id="id_curso_filtro" name="id_curso" onchange="this.form.submit()">
        <option value="">-- Todos mis cursos --</option>
        <% cursos.forEach(function(curso) { %>
          <option
            value="<%= curso.id_curso %>"
            <%= String(idCursoSeleccionado) === String(curso.id_curso) ? 'selected' : '' %>
          >
            <%= curso.nombre %> <%= curso.paralelo %>
          </option>
        <% }); %>
      </select>
    <% } %>
  </form>
</div>

<% if (idMateriaSeleccionada) { %>
  <% if (estudiantes.length === 0) { %>
    <p>No hay estudiantes matriculados en este periodo<%= idCursoSeleccionado ? ' para ese curso' : '' %>.</p>
  <% } else { %>
    <p>Se cargaron <strong><%= estudiantes.length %></strong> estudiantes. Escriba las notas y guarde todo de una vez:</p>
    <form action="/calificaciones/lote" method="POST">
      <input type="hidden" name="id_periodo" value="<%= idPeriodoSeleccionado %>">
      <input type="hidden" name="id_materia" value="<%= idMateriaSeleccionada %>">
      <input type="hidden" name="id_curso" value="<%= idCursoSeleccionado %>">

      <div style="overflow-x:auto">
      <table>
        <thead>
          <tr>
            <th>Estudiante</th>
            <% tiposEvaluacion.forEach(function(tipo) { %>
              <th>
                <%= tipo.nombre %>
                <br><small><%= tipo.categoria %><%= tipo.es_examen ? ' · examen (20%)' : '' %></small>
              </th>
            <% }); %>
          </tr>
        </thead>
        <tbody>
          <% estudiantes.forEach(function(est) { %>
            <tr>
              <td><%= est.apellidos %> <%= est.nombres %></td>
              <% tiposEvaluacion.forEach(function(tipo) { %>
                <td>
                  <input
                    type="number"
                    name="notas[<%= est.id_estudiante %>][<%= tipo.id_tipo_evaluacion %>]"
                    min="0" max="10" step="0.01"
                    style="width:5.5em"
                    value="<%= (notasExistentes[est.id_estudiante] && notasExistentes[est.id_estudiante][tipo.id_tipo_evaluacion] != null) ? notasExistentes[est.id_estudiante][tipo.id_tipo_evaluacion] : '' %>"
                    placeholder="—"
                  >
                </td>
              <% }); %>
            </tr>
          <% }); %>
        </tbody>
      </table>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-primary">Guardar todas</button>
      </div>
    </form>
    <p><small>Las celdas vacías no se guardan (conservan la nota anterior). La nota mínima de aprobación es 7. Cada parcial pide mínimo 2 insumos formativos.</small></p>
  <% } %>
<% } else { %>
  <p>Seleccione su materia para cargar a todos los estudiantes.</p>
<% } %>

<%- include('../partials/footer') %>
