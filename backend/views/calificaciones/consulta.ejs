<%- include('../partials/header') %>

<h1>Consulta de Calificaciones</h1>

<p class="periodo-fijo">
  Periodo activo (fijo): <strong><%= periodoActivo ? periodoActivo.nombre : '—' %></strong>
</p>

<div class="form-box">
  <form action="/calificaciones/consulta" method="GET">
    <label for="id_periodo">Periodo</label>
    <select id="id_periodo" name="id_periodo" onchange="this.form.submit()">
      <% periodos.forEach(function(periodo) { %>
        <option
          value="<%= periodo.id_periodo %>"
          <%= String(idPeriodoSeleccionado) === String(periodo.id_periodo) ? 'selected' : '' %>
        >
          <%= periodo.nombre %>
        </option>
      <% }); %>
    </select>

    <label for="id_estudiante">Estudiante</label>
    <select id="id_estudiante" name="id_estudiante" onchange="this.form.submit()">
      <option value="">-- Selecciona un estudiante --</option>
      <% estudiantes.forEach(function(est) { %>
        <option
          value="<%= est.id_estudiante %>"
          <%= String(idEstudianteSeleccionado) === String(est.id_estudiante) ? 'selected' : '' %>
        >
          <%= est.apellidos %> <%= est.nombres %>
        </option>
      <% }); %>
    </select>

    <% if (idEstudianteSeleccionado && materiasFiltro && materiasFiltro.length > 0) { %>
      <label for="id_materia">Materia (ver promedio específico)</label>
      <select id="id_materia" name="id_materia" onchange="this.form.submit()">
        <option value="">-- Todas las materias --</option>
        <% materiasFiltro.forEach(function(m) { %>
          <option
            value="<%= m.id_materia %>"
            <%= String(idMateriaSeleccionada) === String(m.id_materia) ? 'selected' : '' %>
          >
            <%= m.nombre %>
          </option>
        <% }); %>
      </select>
    <% } %>
  </form>
</div>

<% if (idPeriodoSeleccionado && idEstudianteSeleccionado) { %>
  <% if (mensajeSinNotas) { %>
    <div class="alert alert-error">
      <%= mensajeSinNotas %>
    </div>
  <% } else { %>
    <% if (promedioMateriaSel !== null && promedioMateriaSel !== undefined) { %>
      <div class="form-box">
        <h2>Promedio en la materia seleccionada: <%= promedioMateriaSel %> — <%= escalaMateriaSel %></h2>
        <p><small>Aprueba con 7.00 o más (sin redondeo).</small></p>
      </div>
    <% } %>

    <% materias.forEach(function(materia) { %>
      <table>
        <thead>
          <tr>
            <th colspan="2"><%= materia.nombre %></th>
          </tr>
          <tr>
            <th>Tipo de evaluación</th>
            <th>Nota</th>
          </tr>
        </thead>
        <tbody>
          <% materia.parciales.forEach(function(parcial) { %>
            <tr>
              <td><%= parcial.tipo %></td>
              <td><%= parcial.valor %></td>
            </tr>
          <% }); %>
          <tr>
            <td><strong>Promedio de la materia</strong></td>
            <td><strong><%= materia.promedio %></strong> (<%= materia.escala %>)</td>
          </tr>
        </tbody>
      </table>
    <% }); %>

    <div class="form-box">
      <h2>Promedio general del periodo: <%= promedioGeneral %></h2>
    </div>
  <% } %>
<% } %>

<%- include('../partials/footer') %>
