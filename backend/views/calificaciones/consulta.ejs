<%- include('../partials/header') %>

<h1>Consulta de Calificaciones</h1>

<div class="form-box">
  <form action="/calificaciones/consulta" method="GET">
    <input type="hidden" name="id_periodo" value="<%= idPeriodoSeleccionado %>">

    <% if (idPeriodoSeleccionado) { %>
      <label for="id_estudiante">Estudiante</label>
      <select id="id_estudiante" name="id_estudiante" onchange="this.form.submit()">
        <option value="">-- Selecciona un estudiante --</option>
        <% estudiantes.forEach(function(est) { %>
          <option
            value="<%= est.id_estudiante %>"
            <%= String(idEstudianteSeleccionado) === String(est.id_estudiante) ? 'selected' : '' %>
          >
            <%= est.apellidos %> <%= est.nombres %>
          </option>
        <% }); %>
      </select>
    <% } %>
  </form>
</div>

<% if (idPeriodoSeleccionado && idEstudianteSeleccionado) { %>
  <% if (mensajeSinNotas) { %>
    <div class="alert alert-error">
      <%= mensajeSinNotas %>
    </div>
  <% } else { %>

    <% if (materias.length > 0) { %>
      <h2 style="margin-top:1.5rem;margin-bottom:0.5rem;">Resumen por Materia</h2>
      <table>
        <thead>
          <tr>
            <th>Materia</th>
            <th>Promedio</th>
          </tr>
        </thead>
        <tbody>
          <% materias.forEach(function(materia) { %>
            <tr>
              <td><%= materia.nombre %></td>
              <td><strong><%= materia.promedio !== null ? materia.promedio : 'Sin notas' %></strong></td>
            </tr>
          <% }); %>
          <tr style="background-color:#dbe3f0;">
            <td><strong>PROMEDIO GENERAL</strong></td>
            <td><strong><%= promedioGeneral !== null ? promedioGeneral : 'Sin notas' %></strong></td>
          </tr>
        </tbody>
      </table>
    <% } %>

    <h2 style="margin-top:2rem;margin-bottom:0.5rem;">Detalle por Materia</h2>
    <% materias.forEach(function(materia) { %>
      <div style="margin-bottom:1.5rem;">
        <h3 style="color:#1e3a8a;"><%= materia.nombre %> — Promedio: <span style="color:<%= materia.promedio >= 7 ? '#166534' : (materia.promedio >= 5 ? '#a16207' : '#991b1b') %>;"><%= materia.promedio %></span></h3>
        <table>
          <thead>
            <tr>
              <th>Evaluacion</th>
              <th>Nota</th>
            </tr>
          </thead>
          <tbody>
            <% materia.parciales.forEach(function(parcial) { %>
              <tr>
                <td><%= parcial.tipo %></td>
                <td><%= parcial.valor %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% }); %>

  <% } %>
<% } else if (idPeriodoSeleccionado) { %>
  <p>Selecciona un estudiante para ver sus calificaciones.</p>
<% } else { %>
  <p>No hay un periodo activo seleccionado. Selecciona un periodo desde el selector superior.</p>
<% } %>

<%- include('../partials/footer') %>