<%- include('partials/header') %>

<div style="background:white;border-radius:12px;padding:1.5rem;margin-bottom:1.5rem;box-shadow:0 2px 8px rgba(0,0,0,0.06);">
    <h1 style="margin-bottom:0.2rem;">Bienvenido, <%= usuario.nombres %></h1>
    <p style="color:#6b7280;font-size:0.95rem;">Rol: <strong style="color:#1e3a8a;"><%= usuario.nombre_rol %></strong></p>
</div>

<div class="cards-grid">
    <div class="card">
        <div style="display:flex;align-items:center;gap:0.8rem;">
            <svg viewBox="0 0 24 24" style="width:32px;height:32px;fill:#1e3a8a;opacity:0.7;"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
            <div>
                <h3>Estudiantes activos</h3>
                <p class="card-number"><%= totalEstudiantes %></p>
            </div>
        </div>
    </div>
    <div class="card">
        <div style="display:flex;align-items:center;gap:0.8rem;">
            <svg viewBox="0 0 24 24" style="width:32px;height:32px;fill:#1e3a8a;opacity:0.7;"><path d="M21 5c-1.11-.35-2.33-.5-3.5-.5-1.95 0-4.05.4-5.5 1.5-1.45-1.1-3.55-1.5-5.5-1.5S2.45 4.9 1 6v14.65c0 .25.25.5.5.5.1 0 .15-.05.25-.05C3.1 20.45 5.05 20 6.5 20c1.95 0 4.05.4 5.5 1.5 1.35-.85 3.8-1.5 5.5-1.5 1.65 0 3.35.3 4.75 1.05.1.05.15.05.25.05.25 0 .5-.25.5-.5V6c-.6-.45-1.25-.75-2-1zm0 13.5c-1.1-.35-2.3-.5-3.5-.5-1.7 0-4.15.65-5.5 1.5V8c1.35-.85 3.8-1.5 5.5-1.5 1.2 0 2.4.15 3.5.5v11.5z"/></svg>
            <div>
                <h3>Materias</h3>
                <p class="card-number"><%= totalMaterias %></p>
            </div>
        </div>
    </div>
    <div class="card">
        <div style="display:flex;align-items:center;gap:0.8rem;">
            <svg viewBox="0 0 24 24" style="width:32px;height:32px;fill:#1e3a8a;opacity:0.7;"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM9 10H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z"/></svg>
            <div>
                <h3>Periodos academicos</h3>
                <p class="card-number"><%= totalPeriodos %></p>
            </div>
        </div>
    </div>
    <div class="card">
        <div style="display:flex;align-items:center;gap:0.8rem;">
            <svg viewBox="0 0 24 24" style="width:32px;height:32px;fill:#1e3a8a;opacity:0.7;"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
            <div>
                <h3>Calificaciones registradas</h3>
                <p class="card-number"><%= totalCalificaciones %></p>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>