<%- include('../partials/header') %>

<h1>Reporte de Promedios por Quimestre</h1>

<% if (idPeriodoSeleccionado) { %>
  <% if (mensajeSinDatos) { %>
    <div class="alert alert-error">
      <%= mensajeSinDatos %>
    </div>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Nombres</th>
          <th>Apellidos</th>
          <th>Promedio General</th>
          <th>Estado</th>
        </tr>
      </thead>
      <tbody>
        <% reporte.forEach(function(fila) { %>
          <tr>
            <td><%= fila.nombres %></td>
            <td><%= fila.apellidos %></td>
            <td><strong><%= fila.promedio !== null ? fila.promedio : 'Sin calificaciones' %></strong></td>
            <td>
              <% if (fila.promedio !== null) { %>
                <% if (fila.promedio >= 7) { %>
                  <span style="color:#166534;font-weight:bold;">Aprobado</span>
                <% } else if (fila.promedio >= 5) { %>
                  <span style="color:#a16207;font-weight:bold;">Supletorio</span>
                <% } else { %>
                  <span style="color:#991b1b;font-weight:bold;">Reprobado</span>
                <% } %>
              <% } else { %>
                <span style="color:#6b7280;">--</span>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
<% } else { %>
  <p>No hay un periodo activo seleccionado. Selecciona un periodo desde el selector superior.</p>
<% } %>

<%- include('../partials/footer') %>