<%- include('../partials/header') %>

<h1>Reporte de Promedios por Periodo</h1>

<p class="periodo-fijo">
  Periodo activo (fijo): <strong><%= periodoActivo ? periodoActivo.nombre : '—' %></strong>
</p>

<div class="form-box">
  <form action="/reportes" method="GET">
    <label for="id_periodo">Periodo</label>
    <select id="id_periodo" name="id_periodo" onchange="this.form.submit()">
      <% periodos.forEach(function(periodo) { %>
        <option
          value="<%= periodo.id_periodo %>"
          <%= String(idPeriodoSeleccionado) === String(periodo.id_periodo) ? 'selected' : '' %>
        >
          <%= periodo.nombre %>
        </option>
      <% }); %>
    </select>

    <% if (cursos && cursos.length > 0) { %>
      <label for="id_curso">Curso</label>
      <select id="id_curso" name="id_curso" onchange="this.form.submit()">
        <option value="">-- Todos los cursos --</option>
        <% cursos.forEach(function(curso) { %>
          <option
            value="<%= curso.id_curso %>"
            <%= String(idCursoSeleccionado) === String(curso.id_curso) ? 'selected' : '' %>
          >
            <%= curso.nombre %> <%= curso.paralelo %>
          </option>
        <% }); %>
      </select>
    <% } %>

    <label for="id_materia">Materia (promedio específico)</label>
    <select id="id_materia" name="id_materia" onchange="this.form.submit()">
      <option value="">-- Promedio general --</option>
      <% materias.forEach(function(materia) { %>
        <option
          value="<%= materia.id_materia %>"
          <%= String(idMateriaSeleccionada) === String(materia.id_materia) ? 'selected' : '' %>
        >
          <%= materia.nombre %>
        </option>
      <% }); %>
    </select>
  </form>
</div>

<% if (idPeriodoSeleccionado) { %>
  <% if (mensajeSinDatos) { %>
    <div class="alert alert-error">
      <%= mensajeSinDatos %>
    </div>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Nombres</th>
          <th>Apellidos</th>
          <th>Curso</th>
          <% if (idMateriaSeleccionada) { %>
            <th>Promedio materia</th>
          <% } %>
          <th>Promedio general</th>
          <th>Escala</th>
        </tr>
      </thead>
      <tbody>
        <% reporte.forEach(function(fila) { %>
          <tr>
            <td><%= fila.nombres %></td>
            <td><%= fila.apellidos %></td>
            <td><%= fila.curso || '—' %></td>
            <% if (idMateriaSeleccionada) { %>
              <td><%= fila.promedio_materia !== null ? fila.promedio_materia : 'Sin calificaciones' %></td>
            <% } %>
            <td><%= fila.promedio_general !== null ? fila.promedio_general : 'Sin calificaciones' %></td>
            <td><%= fila.escala %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
<% } %>

<%- include('../partials/footer') %>
