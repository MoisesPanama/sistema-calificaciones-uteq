<%- include('../partials/header') %>

<h1>Gestión de Materias</h1>

<% if (errores && errores.length > 0) { %>
  <div class="alert alert-error">
    <ul>
      <% errores.forEach(function(err) { %>
        <li><%= err %></li>
      <% }); %>
    </ul>
  </div>
<% } %>

<div class="search-bar">
  <button type="button" class="btn-secondary" onclick="abrirModal()">+ Nueva Materia</button>
</div>

<table>
  <thead>
    <tr>
      <th>Nombre</th>
      <th>Descripción</th>
    </tr>
  </thead>
  <tbody>
    <% materias.forEach(function(materia) { %>
      <tr>
        <td><%= materia.nombre %></td>
        <td><%= materia.descripcion %></td>
      </tr>
    <% }); %>
  </tbody>
</table>

<div class="modal-fondo" id="modalMateria">
  <div class="modal-caja">
    <h2>Nueva Materia</h2>
    <form action="/materias" method="POST" class="form-box">
      <label for="nombre">Nombre</label>
      <input type="text" id="nombre" name="nombre" required>

      <label for="descripcion">Descripción</label>
      <input type="text" id="descripcion" name="descripcion">

      <div class="form-actions">
        <button type="submit" class="btn-primary">Guardar</button>
        <button type="button" class="btn-danger btn-secondary" onclick="cerrarModal()">Cancelar</button>
      </div>
    </form>
  </div>
</div>

<script>
  function abrirModal() {
    document.getElementById('modalMateria').classList.add('activo');
  }

  function cerrarModal() {
    document.getElementById('modalMateria').classList.remove('activo');
  }
</script>

<%- include('../partials/footer') %>