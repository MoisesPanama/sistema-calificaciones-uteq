<%- include('../partials/header') %>

<h1>Auditoría del Sistema</h1>

<% if (registros.length === 0) { %>
  <div class="audit-empty">
    <svg viewBox="0 0 24 24" style="width:48px;height:48px;fill:#9ca3af;"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
    <p>No hay registros de auditoría todavía.</p>
  </div>
<% } else { %>

<div class="audit-stats">
  <div class="audit-stat">
    <span class="audit-stat-num"><%= registros.length %></span>
    <span class="audit-stat-label">Total registros</span>
  </div>
  <div class="audit-stat">
    <span class="audit-stat-num"><%= registros.filter(r => r.operacion === 'INSERT').length %></span>
    <span class="audit-stat-label">Inserciones</span>
  </div>
  <div class="audit-stat">
    <span class="audit-stat-num"><%= registros.filter(r => r.operacion === 'UPDATE').length %></span>
    <span class="audit-stat-label">Actualizaciones</span>
  </div>
  <div class="audit-stat">
    <span class="audit-stat-num"><%= registros.filter(r => r.operacion === 'DELETE').length %></span>
    <span class="audit-stat-label">Eliminaciones</span>
  </div>
</div>

<div class="audit-table-wrapper">
  <table class="audit-table">
    <thead>
      <tr>
        <th>Fecha</th>
        <th>Tabla</th>
        <th>Operación</th>
        <th>ID</th>
        <th>Usuario</th>
        <th>Cambios</th>
      </tr>
    </thead>
    <tbody>
      <% registros.forEach(function(reg) { %>
        <tr>
          <td class="audit-fecha"><%= new Date(reg.fecha_evento).toLocaleDateString('es-EC', { day:'2-digit', month:'short', year:'numeric' }) %><br><small><%= new Date(reg.fecha_evento).toLocaleTimeString('es-EC') %></small></td>
          <td><span class="audit-badge audit-badge-table"><%= reg.tabla_afectada %></span></td>
          <td>
            <% if (reg.operacion === 'INSERT') { %>
              <span class="audit-badge audit-badge-insert">INSERT</span>
            <% } else if (reg.operacion === 'UPDATE') { %>
              <span class="audit-badge audit-badge-update">UPDATE</span>
            <% } else { %>
              <span class="audit-badge audit-badge-delete">DELETE</span>
            <% } %>
          </td>
          <td class="audit-id"><%= reg.id_registro || '—' %></td>
          <td><%= reg.usuario_nombres ? (reg.usuario_nombres + ' ' + reg.usuario_apellidos) : reg.usuario_bd %></td>
          <td class="audit-cambios">
            <% if (reg.datos_anteriores || reg.datos_nuevos) { %>
              <button class="audit-toggle" onclick="this.parentElement.querySelector('.audit-json-wrap').classList.toggle('activo'); this.textContent = this.textContent === 'Ver detalle' ? 'Ocultar' : 'Ver detalle'">Ver detalle</button>
              <div class="audit-json-wrap">
                <% if (reg.datos_anteriores && reg.datos_nuevos) { %>
                  <div class="audit-json-col">
                    <div class="audit-json-label">Antes</div>
                    <pre class="audit-json"><%= JSON.stringify(reg.datos_anteriores, null, 2) %></pre>
                  </div>
                  <div class="audit-json-col">
                    <div class="audit-json-label">Después</div>
                    <pre class="audit-json"><%= JSON.stringify(reg.datos_nuevos, null, 2) %></pre>
                  </div>
                <% } else if (reg.datos_nuevos) { %>
                  <div class="audit-json-col" style="flex:1;">
                    <div class="audit-json-label">Datos</div>
                    <pre class="audit-json"><%= JSON.stringify(reg.datos_nuevos, null, 2) %></pre>
                  </div>
                <% } else { %>
                  <div class="audit-json-col" style="flex:1;">
                    <div class="audit-json-label">Datos anteriores</div>
                    <pre class="audit-json"><%= JSON.stringify(reg.datos_anteriores, null, 2) %></pre>
                  </div>
                <% } %>
              </div>
            <% } else { %>
              <span class="audit-sin-cambios">—</span>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<% } %>

<style>
  .audit-empty {
    text-align: center;
    padding: 3rem 1rem;
    color: #6b7280;
  }
  .audit-empty p { margin-top: 0.5rem; font-size: 0.95rem; }

  .audit-stats {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .audit-stat {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    padding: 1rem 1.5rem;
    flex: 1;
    min-width: 140px;
    text-align: center;
  }
  .audit-stat-num {
    display: block;
    font-size: 1.6rem;
    font-weight: 700;
    color: #1e3a8a;
  }
  .audit-stat-label {
    font-size: 0.78rem;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .audit-table-wrapper {
    background: white;
    border-radius: 12px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    overflow-x: auto;
  }

  .audit-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }
  .audit-table th {
    background: #1e3a8a;
    color: white;
    padding: 0.7rem 1rem;
    text-align: left;
    font-weight: 600;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }
  .audit-table td {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid #f3f4f6;
    vertical-align: top;
  }
  .audit-table tbody tr:hover { background: #f9fafb; }

  .audit-fecha { white-space: nowrap; font-size: 0.82rem; color: #374151; }
  .audit-fecha small { color: #9ca3af; }
  .audit-id { font-family: monospace; font-weight: 600; color: #1e3a8a; }

  .audit-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .audit-badge-table { background: #e0e7ff; color: #3730a3; }
  .audit-badge-insert { background: #dcfce7; color: #166534; }
  .audit-badge-update { background: #fef3c7; color: #92400e; }
  .audit-badge-delete { background: #fee2e2; color: #991b1b; }

  .audit-cambios { max-width: 400px; }

  .audit-toggle {
    background: #f3f4f6;
    border: 1px solid #d1d5db;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    font-size: 0.78rem;
    cursor: pointer;
    color: #374151;
    transition: background 0.15s;
  }
  .audit-toggle:hover { background: #e5e7eb; }

  .audit-json-wrap {
    display: none;
    margin-top: 0.5rem;
    gap: 0.5rem;
  }
  .audit-json-wrap.activo { display: flex; }

  .audit-json-col {
    flex: 1;
    min-width: 0;
  }
  .audit-json-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #6b7280;
    margin-bottom: 0.25rem;
  }
  .audit-json {
    background: #1f2937;
    color: #a5f3fc;
    padding: 0.6rem 0.8rem;
    border-radius: 8px;
    font-size: 0.72rem;
    line-height: 1.5;
    overflow-x: auto;
    white-space: pre;
    margin: 0;
    max-height: 220px;
    overflow-y: auto;
  }

  .audit-sin-cambios { color: #d1d5db; }
</style>

<%- include('../partials/footer') %>
