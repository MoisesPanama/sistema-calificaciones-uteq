<%- include('../partials/header') %>

<h1>Auditoría del Sistema</h1>

<% if (registros.length === 0) { %>
  <p>No hay registros de auditoría todavía.</p>
<% } else { %>
<table>
  <thead>
    <tr>
      <th>Fecha</th>
      <th>Tabla</th>
      <th>Operación</th>
      <th>ID registro</th>
      <th>Usuario (app)</th>
      <th>Usuario (BD)</th>
      <th>Datos anteriores</th>
      <th>Datos nuevos</th>
    </tr>
  </thead>
  <tbody>
    <% registros.forEach(function(reg) { %>
      <tr>
        <td><%= new Date(reg.fecha_evento).toLocaleString('es-EC') %></td>
        <td><%= reg.tabla_afectada %></td>
        <td><%= reg.operacion %></td>
        <td><%= reg.id_registro %></td>
        <td>
          <%= reg.usuario_nombres ? (reg.usuario_nombres + ' ' + reg.usuario_apellidos) : '—' %>
        </td>
        <td><%= reg.usuario_bd %></td>
        <td><pre><%= reg.datos_anteriores ? JSON.stringify(reg.datos_anteriores, null, 2) : '—' %></pre></td>
        <td><pre><%= reg.datos_nuevos ? JSON.stringify(reg.datos_nuevos, null, 2) : '—' %></pre></td>
      </tr>
    <% }); %>
  </tbody>
</table>
<% } %>

<%- include('../partials/footer') %>