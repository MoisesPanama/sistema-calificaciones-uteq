<%- include('../partials/header') %>

<h1><%= estudiante ? 'Editar estudiante' : 'Nuevo estudiante' %></h1>

<% if (errores.length > 0) { %>
    <div class="alert alert-error">
        <ul>
            <% errores.forEach(function(err) { %>
                <li><%= err %></li>
            <% }); %>
        </ul>
    </div>
<% } %>

<form
    action="<%= estudiante && estudiante.id_estudiante ? '/estudiantes/' + estudiante.id_estudiante + '?_method=PUT' : '/estudiantes' %>"
    method="POST"
    class="form-box"
>
    <label for="cedula">Cedula</label>
    <input type="text" id="cedula" name="cedula" value="<%= estudiante ? estudiante.cedula : '' %>" required>

    <label for="nombres">Nombres</label>
    <input type="text" id="nombres" name="nombres" value="<%= estudiante ? estudiante.nombres : '' %>" required>

    <label for="apellidos">Apellidos</label>
    <input type="text" id="apellidos" name="apellidos" value="<%= estudiante ? estudiante.apellidos : '' %>" required>

    <label for="fecha_nacimiento">Fecha de nacimiento</label>
    <input
        type="date"
        id="fecha_nacimiento"
        name="fecha_nacimiento"
        value="<%= estudiante && estudiante.fecha_nacimiento ? new Date(estudiante.fecha_nacimiento).toISOString().split('T')[0] : '' %>"
        required
    >

    <label for="id_representante">Representante</label>
    <select id="id_representante" name="id_representante" required>
        <option value="">-- Selecciona un representante --</option>
        <% representantes.forEach(function(rep) { %>
            <option
                value="<%= rep.id_representante %>"
                <%= estudiante && String(estudiante.id_representante) === String(rep.id_representante) ? 'selected' : '' %>
            >
                <%= rep.nombres %> <%= rep.apellidos %>
            </option>
        <% }); %>
    </select>

    <% if (estudiante && estudiante.id_estudiante) { %>
        <label class="checkbox-label">
            <input type="checkbox" name="activo" <%= estudiante.activo ? 'checked' : '' %>>
            Estudiante activo
        </label>
    <% } %>

    <div class="form-actions">
        <button type="submit" class="btn-primary">Guardar</button>
        <a href="/estudiantes" class="btn-danger btn-secondary">Cancelar</a>
    </div>
</form>

<%- include('../partials/footer') %>