<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Calificaciones - UTEQ</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="layout">
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <svg viewBox="0 0 24 24" style="width:28px;height:28px;fill:white;"><path d="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3zm6.82 6L12 12.72 5.18 9 12 5.28 18.82 9zM17 15.99l-5 2.73-5-2.73v-3.72L12 15l5-2.73v3.72z"/></svg>
                <span>UTEQ</span>
            </div>
            <nav class="sidebar-nav">
                <a href="/dashboard" class="sidebar-link" data-ruta="/dashboard">
                    <svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
                    <span>Inicio</span>
                </a>
                <a href="/estudiantes" class="sidebar-link" data-ruta="/estudiantes">
                    <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                    <span>Estudiantes</span>
                </a>
                <a href="/materias" class="sidebar-link" data-ruta="/materias">
                    <svg viewBox="0 0 24 24"><path d="M21 5c-1.11-.35-2.33-.5-3.5-.5-1.95 0-4.05.4-5.5 1.5-1.45-1.1-3.55-1.5-5.5-1.5S2.45 4.9 1 6v14.65c0 .25.25.5.5.5.1 0 .15-.05.25-.05C3.1 20.45 5.05 20 6.5 20c1.95 0 4.05.4 5.5 1.5 1.35-.85 3.8-1.5 5.5-1.5 1.65 0 3.35.3 4.75 1.05.1.05.15.05.25.05.25 0 .5-.25.5-.5V6c-.6-.45-1.25-.75-2-1zm0 13.5c-1.1-.35-2.3-.5-3.5-.5-1.7 0-4.15.65-5.5 1.5V8c1.35-.85 3.8-1.5 5.5-1.5 1.2 0 2.4.15 3.5.5v11.5z"/></svg>
                    <span>Materias</span>
                </a>
                <a href="/periodos" class="sidebar-link" data-ruta="/periodos">
                    <svg viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM9 10H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z"/></svg>
                    <span>Periodos</span>
                </a>
                <div class="sidebar-divider"></div>
                <a href="/calificaciones/nueva" class="sidebar-link" data-ruta="/calificaciones/nueva">
                    <svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                    <span>Registrar Nota</span>
                </a>
                <a href="/calificaciones/consulta" class="sidebar-link" data-ruta="/calificaciones/consulta">
                    <svg viewBox="0 0 24 24"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>
                    <span>Consultar Notas</span>
                </a>
                <a href="/reportes" class="sidebar-link" data-ruta="/reportes">
                    <svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg>
                    <span>Reportes</span>
                </a>
                <% if (usuario.nombre_rol === 'administrador') { %>
                <div class="sidebar-divider"></div>
                <a href="/auditoria" class="sidebar-link" data-ruta="/auditoria">
                    <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
                    <span>Auditoria</span>
                </a>
                <a href="/tipos-evaluacion" class="sidebar-link" data-ruta="/tipos-evaluacion">
                    <svg viewBox="0 0 24 24"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
                    <span>Tipos Evaluacion</span>
                </a>
                <% } %>
            </nav>
            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <svg viewBox="0 0 24 24" style="width:18px;height:18px;fill:rgba(255,255,255,0.6);"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                    <div>
                        <div class="sidebar-user-name"><%= usuario.nombres %></div>
                        <div class="sidebar-user-role"><%= usuario.nombre_rol %></div>
                    </div>
                </div>
                <form action="/logout" method="POST">
                    <button type="submit" class="sidebar-logout">
                        <svg viewBox="0 0 24 24" style="width:18px;height:18px;"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/></svg>
                        <span>Cerrar sesion</span>
                    </button>
                </form>
            </div>
        </aside>
        <div class="topbar-wrapper">
            <header class="topbar">
                <button class="topbar-toggle" onclick="document.getElementById('sidebar').classList.toggle('sidebar-collapsed')">
                    <svg viewBox="0 0 24 24" style="width:20px;height:20px;fill:#374151;"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg>
                </button>
                <div class="topbar-right">
                    <% if (typeof periodos !== 'undefined' && periodos && periodos.length > 0) { %>
                    <div class="header-periodo" id="selectorPeriodo">
                        <button class="header-periodo-btn" onclick="toggleDropdownPeriodo()">
                            <svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:currentColor;"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM9 10H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z"/></svg>
                            <span id="periodoActualNombre"></span>
                            <svg viewBox="0 0 24 24" style="width:12px;height:12px;"><path d="M7 10l5 5 5-5z"/></svg>
                        </button>
                        <div class="header-periodo-dropdown" id="dropdownPeriodo">
                            <div class="header-periodo-dropdown-header">
                                <svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:#1e3a8a;"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM9 10H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z"/></svg>
                                PERIODO ACADEMICO
                            </div>
                            <div class="header-periodo-dropdown-title">Periodos disponibles</div>
                            <% periodos.forEach(function(periodo) { %>
                                <a class="header-periodo-item" data-periodo-id="<%= periodo.id_periodo %>" href="#" onclick="cambiarPeriodo(<%= periodo.id_periodo %>); return false;">
                                    <span class="check"></span>
                                    <%= periodo.nombre %>
                                </a>
                            <% }); %>
                            <div class="header-periodo-footer">
                                <svg viewBox="0 0 24 24" style="width:12px;height:12px;fill:#6b7280;vertical-align:middle;margin-right:0.2rem;"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
                                Selecciona un periodo para cambiar
                            </div>
                        </div>
                    </div>
                    <% } %>
                </div>
            </header>
            <main class="main-content">
