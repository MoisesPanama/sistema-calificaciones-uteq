# Configuracion de conexion a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=calificaciones_uteq
DB_USER=app_uteq
DB_PASSWORD=cambiar_esta_password

# Puerto donde corre la API Express
PORT=3000

# URL publica del frontend (para CORS). El frontend corre en otro puerto.
FRONTEND_URL=http://localhost:5173

# Secreto usado para firmar las cookies de sesion
SESSION_SECRET=cambiar_este_secreto_por_uno_largo_y_aleatorio

# Password de PRUEBA para usuarios de desarrollo (solo local).
# La usa `npm run seed:test-users`, que genera el hash bcrypt al
# momento en vez de usar un hash fijo commiteado. No usar en
# entornos compartidos sin cambiarla.
# TEST_USER_PASSWORD=UTEQ2026
# Ids de usuarios de prueba (separados por coma).
# TEST_USER_IDS=1,4,5,6,7,8

# Maximo de archivos de respaldo .sql a conservar en backend/backups/.
# Al superar el limite se borran los mas antiguos (rotacion).
# RESPALDOS_MAX_ARCHIVOS=30
# Carpeta de respaldos (absoluta o relativa a backend/). Para pruebas
# usa otra carpeta y no mezclar/rotar los respaldos reales.
# RESPALDOS_DIR=backups