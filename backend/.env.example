# Configuracion de conexion a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=calificaciones_uteq
DB_USER=app_uteq
DB_PASSWORD=cambiar_esta_password

# Puerto donde corre la API Express
PORT=3000

# URL publica del frontend (para CORS). El frontend corre en otro puerto.
FRONTEND_URL=http://localhost:5173

# Secreto usado para firmar las cookies de sesion
SESSION_SECRET=cambiar_este_secreto_por_uno_largo_y_aleatorio